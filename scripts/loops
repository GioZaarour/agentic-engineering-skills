#!/usr/bin/env bash
#
# loops — run issue loops in tmux, using the current checkout when it is already
# on the issue branch and a dedicated worktree otherwise.
#
#   ./scripts/loops run 19 21 24                   # Claude, three loops at once
#   ./scripts/loops run --cli codex 24 -- --no-push  # args after -- go to each loop
#   ./scripts/loops status [--all]                 # latest run per issue, or every run
#
# Each loop records its progress in <git common dir>/loops/<run-id>.json (see
# write_status in loops-lib.sh). That directory is shared by every worktree, so
# this command finds every run without knowing where its worktree is.
#
# Where a user systemd instance exists (most Linux hosts), every loop runs in
# one shared slice with a memory ceiling — see contain_memory.

set -uo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
COMMON_DIR="$(git rev-parse --path-format=absolute --git-common-dir)" || exit 2
REGISTRY="$COMMON_DIR/loops"
MAIN_ROOT="$(dirname "$COMMON_DIR")"
REPO_NAME="$(basename "$MAIN_ROOT")"
BASE_BRANCH="${BASE_BRANCH:-main}"
# Dedicated worktrees go in <parent>/<repo>-loops/issue-<N>. Setting only the
# parent lets one exported value serve every repository: each still gets its own
# <repo>-loops folder, so issue numbers from two repositories never collide.
# LOOPS_WORKTREE_ROOT names the folder itself and wins when both are set.
LOOPS_WORKTREE_PARENT="${LOOPS_WORKTREE_PARENT:-$(dirname "$MAIN_ROOT")}"
WORKTREE_ROOT="${LOOPS_WORKTREE_ROOT:-$LOOPS_WORKTREE_PARENT/$REPO_NAME-loops}"
LOOPS_CGROUP="${LOOPS_CGROUP:-auto}"                      # auto | on | off
LOOPS_SLICE="${LOOPS_SLICE:-loops.slice}"
LOOPS_MEMORY_RESERVE_MB="${LOOPS_MEMORY_RESERVE_MB:-1024}"
LOOPS_MEMORY_MAX="${LOOPS_MEMORY_MAX:-}"                  # systemd size, e.g. 12G; default: RAM minus the reserve

usage() {
  sed -n '6,8p' "${BASH_SOURCE[0]}" | sed 's/^# //'
}

# Registry entries, newest last, one line per run with \x1f between fields.
# The separator is not whitespace, so `read` keeps empty fields in place.
runs() {
  local all="$1" files=("$REGISTRY"/*.json)
  [[ -e "${files[0]}" ]] || return 0
  jq -rs --argjson all "$all" --argjson now "$(date +%s)" '
    sort_by(.started)
    | if $all then . else group_by(.issue) | map(last) | sort_by(.issue) end
    | .[] | [.issue, .cli, .stage, .state, .pid, .branch, .base, ($now - .updated),
             .from, .pr, .tmux, .reason, .log] | map(tostring) | join("\u001f")' "${files[@]}"
}

ago() {
  local s="$1"
  if   (( s < 3600 ));  then echo "$(( s / 60 ))m"
  elif (( s < 86400 )); then echo "$(( s / 3600 ))h"
  else echo "$(( s / 86400 ))d"
  fi
}

cmd_status() {
  local all=false issue cli stage state pid branch base age from pr tmux reason log commits next
  [[ "${1:-}" == --all || "${1:-}" == -a ]] && all=true
  compgen -G "$REGISTRY/*.json" >/dev/null || { echo "no loop runs recorded in $REGISTRY"; return 0; }
  printf '%-6s %-7s %-12s %-12s %-8s %-8s %s\n' ISSUE CLI STAGE STATE COMMITS UPDATED NEXT
  while IFS=$'\x1f' read -r issue cli stage state pid branch base age from pr tmux reason log; do
    # A run that says it is running but whose process is gone was SIGKILLed or
    # lost its machine; nothing got to record that, so infer it here.
    if [[ "$state" == running ]] && ! kill -0 "$pid" 2>/dev/null; then
      state=died; reason="the process exited without recording an outcome"
    fi
    commits=-
    [[ -n "$branch" ]] && commits=$(git rev-list --count "origin/$base..$branch" 2>/dev/null || echo -)
    case "$state" in
      running) next=${tmux:+"tmux attach -t $tmux"}; next=${next:-"tail -f $log"} ;;
      done)    next=${pr:-done} ;;
      *)       next="./scripts/loops run"; [[ "$cli" == codex ]] && next+=" --cli codex"
               next+=" $issue${from:+ -- --from $from}" ;;
    esac
    printf '%-6s %-7s %-12s %-12s %-8s %-8s %s\n' "#$issue" "$cli" "$stage" "$state" \
      "$commits" "$(ago "$age")" "$next"
    [[ "$state" == running || "$state" == done ]] || printf '       ↳ %s · %s\n' "${reason:-see the log}" "$log"
  done < <(runs "$all")
}

# ── contain_memory ────────────────────────────────────────────────────────
# Puts every loop into one systemd slice whose MemoryMax is the machine's RAM
# minus LOOPS_MEMORY_RESERVE_MB, by filling the `wrap` array the tmux command is
# prefixed with. The slice is shared by all loops on the machine, including
# loops of other repositories, because the limit protects the machine, not one
# repository.
#
# The budget in loops-lib.sh is what keeps loops inside their share, but it is
# an instruction in a prompt and an agent can ignore it. Without a slice, the
# kernel's OOM killer then picks the largest process on the machine, which can
# be your interactive session or the tmux server holding every loop. With one,
# it picks inside the slice: a compiler or one loop's agent, and that loop stops
# recoverably.
#
# auto uses the slice when it can be set up, and otherwise runs the loops
# uncontained with a note. on refuses to start without it. off never uses it.
contain_memory() {
  local mem_mb limit
  wrap=()
  [[ "$LOOPS_CGROUP" == off ]] && return 0
  [[ "$LOOPS_CGROUP" == auto || "$LOOPS_CGROUP" == on ]] \
    || { echo "LOOPS_CGROUP must be auto, on or off" >&2; return 2; }
  if ! command -v systemd-run >/dev/null || ! systemctl --user show-environment >/dev/null 2>&1; then
    uncontained "no systemd-run or user systemd instance to put the loops in"
    return
  fi
  limit="$LOOPS_MEMORY_MAX"
  if [[ -z "$limit" ]]; then
    mem_mb=$(awk '/^MemTotal:/ {print int($2/1024)}' /proc/meminfo 2>/dev/null)
    if ! [[ "$mem_mb" =~ ^[0-9]+$ && "$LOOPS_MEMORY_RESERVE_MB" =~ ^[0-9]+$ ]] \
       || (( mem_mb <= LOOPS_MEMORY_RESERVE_MB )); then
      uncontained "cannot size the memory ceiling from ${mem_mb:-unknown} MB RAM and a" \
                  "${LOOPS_MEMORY_RESERVE_MB} MB reserve — set LOOPS_MEMORY_MAX"
      return
    fi
    limit="$(( mem_mb - LOOPS_MEMORY_RESERVE_MB ))M"
  fi
  if ! systemctl --user set-property --runtime "$LOOPS_SLICE" "MemoryMax=$limit"; then
    uncontained "cannot set MemoryMax=$limit on $LOOPS_SLICE"
    return
  fi
  wrap=(systemd-run --user --scope --quiet "--slice=$LOOPS_SLICE" --)
  echo "memory: loops share $LOOPS_SLICE, MemoryMax=$limit"
}

# The slice cannot be used. Under LOOPS_CGROUP=on that stops the command (2);
# under auto the loops start without it (0), and the reason is printed.
uncontained() {
  if [[ "$LOOPS_CGROUP" == on ]]; then echo "$*" >&2; return 2; fi
  echo "memory: $* — loops run without a shared memory ceiling"
}

# A numbered issue branch in the invoking checkout is an explicit choice to
# work there. All other runs use the issue's dedicated worktree, including runs
# whose older status record points at an unrelated checkout.
cmd_run() {
  local cli=claude n wt session rc=0 var current_root current_branch tmux_version tmux_major tmux_minor
  local -a issues=() pass=() env_args=() wrap=()
  while (( $# )); do
    case "$1" in
      --cli) cli="$2"; shift 2 ;;
      --)    shift; pass=("$@"); break ;;
      -h|--help) usage; return 0 ;;
      *)     [[ "$1" =~ ^[0-9]+$ ]] || { usage >&2; return 2; }; issues+=("$1"); shift ;;
    esac
  done
  [[ "$cli" == claude || "$cli" == codex ]] || { echo "--cli must be claude or codex" >&2; return 2; }
  (( ${#issues[@]} )) || { usage >&2; return 2; }
  command -v tmux >/dev/null || { echo "tmux is required" >&2; return 2; }
  tmux_version=$(tmux -V) || { echo "cannot determine tmux version" >&2; return 2; }
  if [[ ! "$tmux_version" =~ ^tmux[[:space:]]+([0-9]+)\.([0-9]+) ]]; then
    echo "cannot parse tmux version: $tmux_version" >&2; return 2
  fi
  tmux_major=$((10#${BASH_REMATCH[1]}))
  tmux_minor=$((10#${BASH_REMATCH[2]}))
  if (( tmux_major < 3 || (tmux_major == 3 && tmux_minor < 2) )); then
    echo "tmux 3.2 or newer is required (found $tmux_version)" >&2; return 2
  fi
  current_root="$(git rev-parse --show-toplevel)" || return 2
  current_branch="$(git branch --show-current)" || return 2

  # A session started by a running tmux server inherits the server's
  # environment, not this shell's. Forward PATH and every loop setting that is
  # set here, so PLAN_MODEL=... ./scripts/loops run ... behaves as it reads.
  for var in PATH $(grep -ohE '\$\{[A-Z_]+:-' "$SCRIPT_DIR"/loops-lib.sh "$SCRIPT_DIR"/claude-issue-loop.sh \
                    | tr -d '${:-' | sort -u); do
    [[ "$var" != TMUX && -n "${!var+x}" ]] && env_args+=(-e "$var=${!var}")
  done

  contain_memory || return 2
  git fetch -q origin || { echo "cannot fetch origin" >&2; return 2; }
  for n in "${issues[@]}"; do
    session="${REPO_NAME//[.:]/_}-$n"
    if tmux has-session -t "=$session" 2>/dev/null; then
      echo "#$n is already running — tmux attach -t $session"; continue
    fi
    if [[ "$current_branch" =~ (^|/)$n[-_] ]]; then
      wt="$current_root"
    else
      wt="$WORKTREE_ROOT/issue-$n"
      if [[ -e "$wt" ]]; then
        if [[ "$(git -C "$wt" rev-parse --show-toplevel 2>/dev/null)" != "$(cd "$wt" && pwd -P)" ]] \
           || [[ "$(git -C "$wt" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" != "$COMMON_DIR" ]]; then
          echo "#$n: $wt exists but is not this repo's dedicated worktree" >&2; rc=1; continue
        fi
      elif ! git worktree add -q --detach "$wt" "origin/$BASE_BRANCH"; then
        echo "#$n: cannot create worktree $wt" >&2; rc=1; continue
      fi
    fi
    tmux new-session -d -s "$session" -c "$wt" "${env_args[@]}" \
      "$(printf '%q ' ${wrap[@]+"${wrap[@]}"} "$SCRIPT_DIR/$cli-issue-loop.sh" "$n" ${pass[@]+"${pass[@]}"})" \
      || { rc=1; continue; }
    echo "#$n started in $wt — tmux attach -t $session"
  done
  echo "progress: ./scripts/loops status"
  return "$rc"
}

case "${1:-}" in
  run)    shift; cmd_run "$@" ;;
  status) shift; cmd_status "$@" ;;
  *)      usage >&2; exit 2 ;;
esac
